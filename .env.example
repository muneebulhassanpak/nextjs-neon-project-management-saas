# Copy to .env.local and fill in. Never commit .env.local.
# Every value has a working local default, so a fresh clone runs with this file empty.

# --- App ---
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal | silent
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 00) ---
# Any Postgres URL. Empty means the local Docker database (docker compose up -d db, port 5433).
# Paste a Neon connection string (the pooled one) to work against a Neon branch instead.
# Required on Vercel, where the Neon integration sets it.
DATABASE_URL=
# Optional: Neon's direct connection, used only for migrations. Set by the Neon integration.
DATABASE_URL_UNPOOLED=
# Used only by the integration tests. The database is DROPPED and recreated on every run,
# so never point this at a database you care about.
TEST_DATABASE_URL=postgresql://stackboard:stackboard@localhost:5433/stackboard_test
