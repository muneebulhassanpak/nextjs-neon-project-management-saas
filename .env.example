# Copy to .env.local and fill in. Never commit .env.local.
# Every value has a working local default, so a fresh clone runs with this file empty.

# --- App ---
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal | silent
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 00) ---
# Any Postgres URL. Empty means the local Docker database (docker compose up -d db, port 5433).
# Paste a Neon connection string (the pooled one) to work against a Neon branch instead.
# Required on Vercel, where the Neon integration sets it.
DATABASE_URL=
# Optional: Neon's direct connection, used only for migrations. Set by the Neon integration.
DATABASE_URL_UNPOOLED=
# Used only by the integration tests. The database is DROPPED and recreated on every run,
# so never point this at a database you care about.
TEST_DATABASE_URL=postgresql://stackboard:stackboard@localhost:5433/stackboard_test

# --- Auth (Phase 01) ---
# Long random string. Generate with: openssl rand -base64 32. Required on Vercel.
BETTER_AUTH_SECRET=
# Public URL of the app. Leave empty locally; on Vercel it's worked out from the deployment.
BETTER_AUTH_URL=
# Rate limits sign-in attempts in production. Set to false only for end-to-end tests.
AUTH_RATE_LIMIT=true
# Optional social sign-in. A provider's button only shows when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Phase 01) ---
# console prints emails (with their links) to the server log. resend sends them for real.
EMAIL_MODE=console              # console | resend
RESEND_API_KEY=
EMAIL_FROM=Stackboard <onboarding@resend.dev>
