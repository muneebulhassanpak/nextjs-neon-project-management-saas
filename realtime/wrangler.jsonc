{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stackboard-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }],
  },
  // SQLite-backed Durable Objects are the ones included in the free Workers plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  "observability": { "enabled": true },
  // REALTIME_SECRET is a secret: `wrangler secret put REALTIME_SECRET -c realtime/wrangler.jsonc`.
  // Locally, `pnpm realtime:dev` passes a development value instead.
}
